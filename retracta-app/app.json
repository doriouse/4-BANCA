{
  "expo": {
    "name": "retracta-app",
    "slug": "retracta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Background.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/Background.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF0FE"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Background.png",
        "backgroundColor": "#EAF0FE"
      },
      "package": "com.retractacompany.retractaapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/Background.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o Retracta acesse sua localização para configurar o clima do varal."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2df7f79-670d-45d1-a7e0-90ff01619eeb"
      }
    }
  }
}